modules = ["nodejs-18", "web", "python-3.11"]
[agent]
expertMode = true
integrations = ["github:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5055
externalPort = 3001

[[ports]]
localPort = 5357
externalPort = 5000

[[ports]]
localPort = 5387
externalPort = 3002

[[ports]]
localPort = 5452
externalPort = 3000

[[ports]]
localPort = 5557
externalPort = 5173

[[ports]]
localPort = 5587
externalPort = 3003

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.js"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000
