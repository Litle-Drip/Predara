{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 45
    }
  },
  "rewrites": [
    {
      "source": "/api/discover",
      "destination": "/api/gemini-events?view=discover"
    },
    {
      "source": "/api/match",
      "destination": "/api/gemini-events?view=match"
    }
  ]
}
